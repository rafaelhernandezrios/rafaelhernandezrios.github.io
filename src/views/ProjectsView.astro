---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GithubGrid from '../components/GithubGrid.astro';
import { projects, categories, type Category } from '../data/projects';
import { type Lang, ui, t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const used = [...new Set(projects.flatMap((p) => p.categories))] as Category[];
const title = lang === 'es' ? 'Proyectos | Rafael Hernández' : 'Projects | Rafael Hernández';
const description = lang === 'es'
  ? 'Casos de estudio de robótica, neurotecnología (EEG/BCI), realidad virtual, IA y educación, más todos mis repositorios públicos de GitHub.'
  : 'Case studies in robotics, neurotechnology (EEG/BCI), virtual reality, AI and education, plus all my public GitHub repositories.';
---
<Base lang={lang} title={title} description={description}>
  <section class="head">
    <div class="container">
      <p class="kicker">{t(ui.nav.projects, lang)}</p>
      <h1>{t(ui.projects.all, lang)}</h1>
      <p class="lead">{t(ui.projects.lead, lang)}</p>
      <div class="filters" role="group" aria-label="Filter">
        <button class="is-on" data-filter="all">{t(ui.projects.filterAll, lang)} <span>{projects.length}</span></button>
        {used.map((c) => (
          <button data-filter={c}>{t(categories[c], lang)} <span>{projects.filter((p) => p.categories.includes(c)).length}</span></button>
        ))}
      </div>
    </div>
  </section>
  <section class="section list">
    <div class="container">
      <div class="grid" data-grid>
        {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </div>
  </section>
  <section id="github" class="section section--dark">
    <div class="container">
      <div class="section-head">
        <p class="kicker">GitHub</p>
        <h2>{t(ui.github.title, lang)}</h2>
        <p>{t(ui.github.lead, lang)}</p>
      </div>
      <GithubGrid lang={lang} searchable />
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] > .card');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter!;
    buttons.forEach((x) => x.classList.toggle('is-on', x === b));
    cards.forEach((c) => { c.hidden = f !== 'all' && !c.dataset.cats!.split(' ').includes(f); });
  }));
</script>

<style>
  .head { background: var(--ink); color: #e9edf4; padding: 140px 0 3.5rem; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.4rem); margin-top: 1rem; }
  .lead { color: var(--muted-dark); font-size: 1.12rem; margin-top: 1rem; max-width: 40rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.2rem; }
  .filters button { font: inherit; font-size: 0.9rem; cursor: pointer; padding: 0.55rem 1rem; border-radius: 999px; border: 1px solid var(--line-dark); background: transparent; color: #c9d2e0; display: inline-flex; gap: 0.5rem; align-items: center; transition: background 0.15s, color 0.15s, border-color 0.15s; }
  .filters button span { font-family: var(--font-mono); font-size: 0.72rem; opacity: 0.6; }
  .filters button:hover { border-color: rgba(255,255,255,0.35); color: #fff; }
  .filters button.is-on { background: var(--accent); border-color: var(--accent); color: var(--ink); }
  .list { padding-top: 3rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .grid > [hidden] { display: none; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
</style>
