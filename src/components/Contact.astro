---
import { type Lang, ui, t } from '../i18n/ui';
import { person } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section id="contact" class="contact">
  <div class="container contact__inner reveal">
    <div>
      <p class="kicker">{t(ui.nav.contact, lang)}</p>
      <h2>{t(ui.contact.title, lang)}</h2>
      <p class="lead">{t(ui.contact.lead, lang)}</p>
    </div>
    <div class="contact__actions">
      <a class="mail" href={`mailto:${person.email}`}>
        <span class="mail__label">{t(ui.contact.email, lang)}</span>
        <span class="mail__addr">{person.email}</span>
      </a>
      <div class="socials">
        <a class="btn btn--ghost" href={person.linkedin} target="_blank" rel="me noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          LinkedIn
        </a>
        <a class="btn btn--ghost" href={person.github} target="_blank" rel="me noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/></svg>
          GitHub
        </a>
      </div>
      <p class="loc">📍 {person.location} · {person.org}</p>
    </div>
  </div>
</section>
<style>
  .contact { background: linear-gradient(180deg, var(--ink) 0%, #101b31 100%); color: #e9edf4; padding-block: clamp(5rem, 10vw, 8rem); border-top: 1px solid var(--line-dark); }
  .contact__inner { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: end; }
  h2 { font-size: clamp(2.3rem, 5vw, 3.8rem); margin-top: 1rem; }
  .lead { color: var(--muted-dark); font-size: 1.1rem; margin-top: 1.2rem; max-width: 34rem; }
  .contact__actions { display: grid; gap: 1.2rem; }
  .mail { display: grid; gap: 0.3rem; text-decoration: none; padding: 1.4rem 1.6rem; border-radius: var(--radius-lg); background: var(--accent); color: var(--ink); transition: transform 0.2s, background 0.2s; }
  .mail:hover { transform: translateY(-2px); background: #f5a196; }
  .mail__label { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .mail__addr { font-family: var(--font-display); font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 600; word-break: break-all; }
  .socials { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .loc { color: var(--muted-dark); font-size: 0.9rem; }
  @media (max-width: 850px) { .contact__inner { grid-template-columns: 1fr; } }
</style>
